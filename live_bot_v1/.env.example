# ============================================================
# live_bot_v1 — environment variable template
# Copy to .env (dev) or /etc/nifty_bot/bot.env (VM, chmod 600)
# NEVER commit the real file to version control
# ============================================================

# --- Dhan credentials (pin_totp mode — fully unattended) ---
DHAN_CLIENT_CODE=your_dhan_client_id_here
DHAN_PIN=your_6digit_pin_here
DHAN_TOTP_SECRET=your_base32_totp_secret_here

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Dead-man-switch heartbeat (optional, e.g. healthchecks.io) ---
HEARTBEAT_URL=https://hc-ping.com/your-uuid-here

# --- Live-mode gate (BOTH must be set to allow --live flag) ---
# CONFIRM_LIVE=YES

# --- Expected static IP of the VM (for IP guard) ---
EXPECTED_STATIC_IP=1.2.3.4

# --- Optional: override config paths ---
# BOT_CONFIG_PATH=/etc/nifty_bot/config.yaml
# BOT_STATE_DIR=/var/lib/nifty_bot
# BOT_LOG_DIR=/var/log/nifty_bot
